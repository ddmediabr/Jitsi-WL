# Variáveis do app do PAINEL no Coolify (todas runtime, nenhuma de build; is_literal = true).
# Marcadores: {{DOMAIN}}, {{DB_UUID}} (uuid do banco no Coolify = nome do contêiner na rede), {{JITSI_SERVICE_UUID}},
# {{BRAND_NAME}}; os segredos vêm de build/secrets.env. Opcionais vazios são omitidos pelo script.

# Banco: o dono (só migrações, na inicialização) e o usuário restrito panel_app (criado pelas migrações com APP_DB_PASSWORD).
DATABASE_ADMIN_URL=postgres://panel:{{DB_OWNER_PASSWORD}}@{{DB_UUID}}:5432/panel
DATABASE_URL=postgres://panel_app:{{APP_DB_PASSWORD}}@{{DB_UUID}}:5432/panel
APP_DB_PASSWORD={{APP_DB_PASSWORD}}

# Autenticação do painel. Trocar BETTER_AUTH_SECRET depois invalida o 2FA cadastrado.
BETTER_AUTH_SECRET={{BETTER_AUTH_SECRET}}
BETTER_AUTH_URL=https://{{DOMAIN}}
# Só até criar o primeiro administrador em https://{{DOMAIN}}/settings/setup; depois APAGUE a variável.
SETUP_TOKEN={{SETUP_TOKEN}}

# Marca padrão (emissor do 2FA, títulos e e-mails antes de a marca ser cadastrada em Personalização).
BRAND_NAME={{BRAND_NAME}}

# API interna do Prosody (o mesmo segredo vai no arquivo /prosody-plugins-custom/ddmedia-admin.secret).
PROSODY_ADMIN_URL=http://prosody-{{JITSI_SERVICE_UUID}}:5280/ddmedia-admin
PROSODY_ADMIN_SECRET={{PROSODY_ADMIN_SECRET}}

# Entrega das gravações pelo Jibri (o mesmo segredo vai no serviço do gravador como DDMEDIA_INGEST_SECRET).
RECORDING_INGEST_SECRET={{RECORDING_INGEST_SECRET}}

# Opcionais.
# E-mail (Resend): esqueci a senha, código 2FA por e-mail, link da gravação, envio de transcrição.
RESEND_API_KEY={{RESEND_API_KEY}}
MAIL_FROM={{MAIL_FROM}}
# Transcrição e análise das gravações (Gemini, projeto com faturamento).
GEMINI_API_KEY={{GEMINI_API_KEY}}
# Botão "Aplicar agora" da qualidade de gravação (reinicia o gravador): token do Coolify SÓ com permissão deploy.
COOLIFY_URL={{COOLIFY_URL}}
COOLIFY_API_TOKEN={{COOLIFY_API_TOKEN}}
COOLIFY_JIBRI_SERVICE_UUID={{JIBRI_SERVICE_UUID}}
