# Variáveis do serviço do JITSI no Coolify. Só estas têm valor; todas as outras do compose ficam VAZIAS.
# Marcadores: {{DOMAIN}}, {{PUBLIC_IP}} (IP público do servidor, para a mídia), {{TZ}}.
# {{GERAR}} = segredo aleatório novo por instalação (ex.: `openssl rand -hex 32`). Nunca reutilize segredos entre clientes.
# Ao gravar no Coolify: is_literal = true em todas (o valor de CSP_HEADER tem aspas e espaço).

PUBLIC_URL=https://{{DOMAIN}}
JVB_ADVERTISE_IPS={{PUBLIC_IP}}
TZ={{TZ}}
JITSI_IMAGE_VERSION=stable-11248-3

# HTTPS é do Traefik: o nginx do `web` serve HTTP na porta 8000.
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
CSP_HEADER=frame-ancestors 'self'

# Autenticação interna (contas no Prosody, geridas pelo painel) + convidados anônimos.
ENABLE_AUTH=1
AUTH_TYPE=internal
ENABLE_GUESTS=1
ENABLE_AUTO_LOGIN=0
ENABLE_LOBBY=1
ENABLE_WELCOME_PAGE=1
ENABLE_XMPP_WEBSOCKET=1

# Domínios XMPP internos (padrão do docker-jitsi-meet). XMPP_HIDDEN_DOMAIN precisa ser igual ao do gravador.
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_HIDDEN_DOMAIN=recorder.meet.jitsi
# O alias xmpp.meet.jitsi não resolve no Coolify: use o nome do serviço.
XMPP_SERVER=prosody
XMPP_BOSH_URL_BASE=http://prosody:5280

# Módulos do produto (infra/prosody).
GLOBAL_MODULES=ddmedia_focus_authz,ddmedia_recording_guard,ddmedia_auth_limit
XMPP_MODULES=ddmedia_admin_api
XMPP_MUC_MODULES=ddmedia_reconnect_pass,ddmedia_room_guard

# Ponte de vídeo.
JVB_PORT=10000
JVB_BREWERY_MUC=jvbbrewery
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD={{GERAR}}

# Foco (Jicofo).
JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD={{GERAR}}
JICOFO_COMPONENT_SECRET={{GERAR}}

# Gravação (Jibri). JIBRI_XMPP_PASSWORD e JIBRI_RECORDER_PASSWORD também vão no serviço do gravador, com o MESMO valor.
ENABLE_RECORDING=1
JIBRI_BREWERY_MUC=jibribrewery
JIBRI_PENDING_TIMEOUT=90
JIBRI_XMPP_USER=jibri
JIBRI_XMPP_PASSWORD={{GERAR}}
JIBRI_RECORDER_USER=recorder
JIBRI_RECORDER_PASSWORD={{GERAR}}

# Jigasi não é usado, mas o compose oficial pede as senhas: gere mesmo assim.
JIGASI_XMPP_PASSWORD={{GERAR}}
JIGASI_TRANSCRIBER_PASSWORD={{GERAR}}
